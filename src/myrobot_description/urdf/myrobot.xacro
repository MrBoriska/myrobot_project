<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myrobot">

  <xacro:macro name="box_inertia" params="b_mass b_length b_width b_height">
    <inertial>
      <mass value="${b_mass}"/>
      <inertia ixx="${b_mass*(b_length*b_length+b_height*b_height)/12}" ixy="0.0" ixz="0.0"
               iyy="${b_mass*(b_width*b_width+b_height*b_height)/12}" iyz="0.0"
               izz="${b_mass*(b_length*b_length+b_width*b_width)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="c_mass c_radius c_height">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="${c_mass}"/>
      <inertia ixx="${c_mass*(3*c_radius*c_radius+c_height*c_height)/12}" ixy="0.0" ixz="0.0"
               izz="${c_mass*(3*c_radius*c_radius+c_height*c_height)/12}" iyz="0.0"
               iyy="${c_mass*c_radius*c_radius/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:property name="base_link_mass" value="3.0" /><!-- please correct this -->
  <xacro:property name="base_link_length" value="0.22" />
  <xacro:property name="base_link_width" value="0.22" />
  <xacro:property name="base_link_height" value="0.053" />
  <xacro:property name="wheel_mass" value="0.2" /><!-- please correct this -->
  <xacro:property name="wheel_radius" value="0.0315" /><!-- please correct this -->
  <xacro:property name="wheel_height" value="0.015" /><!-- please correct this -->
  <xacro:property name="track" value="0.17" />
  <xacro:property name="clearance" value="0.015" />

  <!-- base_link is the root of the tree: the wheel odometry publishes
       odom -> base_link directly, so no extra "root_link" frame is needed. -->

  <link name="lidar_link">
    <visual>
      <origin rpy="${pi} 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://myrobot_description/meshes/lds01rr.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red">
        <color rgba="0.6 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.015</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_link_height/2 + 0.005}" rpy="${pi} 0 ${pi/4}"/>
  </joint>


  <link name="imu_link"></link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.038 0.024 ${-base_link_height/2 + 0.008}" rpy="0 0 ${-pi}"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <!-- Same topic as ros2_mpu9250_driver, so slam.yaml is unchanged. -->
          <remapping>~/out:=imu/data_raw</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:macro name="base_link_geometry">
    <geometry>
      <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
    </geometry>
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://myrobot_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <xacro:base_link_geometry />
    </collision>
    <xacro:box_inertia
     b_mass="${base_link_mass}"
     b_length="${base_link_length}"
     b_width="${base_link_width}"
     b_height="${base_link_height}"/>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/RustySteel</material>
  </gazebo>

  <xacro:macro name="wheel_joint" params="w_name origin_x origin_y origin_z geometry_yaw">
    <link name="${w_name}_wheel">
      <visual>
        <geometry>
          <cylinder length="${wheel_height}" radius="${wheel_radius}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 ${geometry_yaw}"/>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${wheel_height}" radius="${wheel_radius}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <xacro:cylinder_inertia
        c_mass="${wheel_mass}"
        c_radius="${wheel_radius}"
        c_height="${wheel_height}"/>
    </link>

    <joint name="base_to_${w_name}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${w_name}_wheel"/>
      <axis xyz="0 1 0"/>
      <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>

    </joint>

    <gazebo reference="${w_name}_wheel">
      <!-- fdir1 must be a unit vector along the rolling direction; "0 0 0" made
           ODE use isotropic friction and the base yawed at zero command. -->
      <mu1 value="0.5"/>
      <mu2 value="1.0"/>
      <fdir1 value="1 0 0"/>

      <!--kp value="10000000.00" />
      <kd value="1.00" />
      <minDepth value="0.001"/-->

      <maxContacts value="1"/>
      <turnGravityOff>false</turnGravityOff>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <transmission name="${w_name}_trans" type="SimpleTransmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="base_to_${w_name}_wheel">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="base_to_${w_name}_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- Simulation-only support: with the two drive wheels at x=0 the base has no
       pitch support and topples in Gazebo. On the real robot the frame itself
       rests on the ground, so these casters are inert. -->
  <xacro:property name="caster_radius" value="0.015" />
  <xacro:macro name="caster" params="c_name origin_x">
    <link name="${c_name}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="grey"><color rgba="0.4 0.4 0.4 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="base_to_${c_name}_caster" type="fixed">
      <parent link="base_link"/>
      <child link="${c_name}_caster"/>
      <origin xyz="${origin_x} 0 ${-base_link_height/2 - clearance + caster_radius}"
              rpy="0 0 0"/>
    </joint>
    <gazebo reference="${c_name}_caster">
      <!-- Small but non-zero: a frictionless sphere lets the base slide and yaw. -->
      <mu1 value="0.01"/>
      <mu2 value="0.01"/>
      <kp value="1000000.0"/>
    </gazebo>
  </xacro:macro>

  <xacro:caster c_name="front" origin_x="0.09"/>
  <xacro:caster c_name="rear" origin_x="-0.09"/>

  <xacro:wheel_joint
    w_name="l"
    origin_y="${track/2}"
    origin_x="0"
    origin_z="${wheel_radius-base_link_height/2-clearance}"
    geometry_yaw="0"/>

  <xacro:wheel_joint
    w_name="r"
    origin_y="${-track/2}"
    origin_x="0"
    origin_z="${wheel_radius-base_link_height/2-clearance}"
    geometry_yaw="0"/>

  <gazebo>
    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>base_to_l_wheel</left_joint>
      <right_joint>base_to_r_wheel</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_diameter>${wheel_radius*2}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- robot_state_publisher already broadcasts the wheel joints. -->
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
